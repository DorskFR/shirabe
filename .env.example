# shirabe configuration — every environment variable it reads, with its default.
# Copy to `.env` for local dev (`make run` / docker-compose pick it up). Flat keys, no `__`.
# Each variable is also a `--flag` (`shirabe --help`). `src/config.rs` is the source of truth;
# a unit test there fails if a variable is missing from this file.

# ── Databases ───────────────────────────────────────────────

# REQUIRED. Postgres DSN for the MusicBrainz mirror. Use a *read-only* role:
# shirabe only runs SELECTs against it. Startup fails fast if unset.
DATABASE_URL=postgres://readonly@mirror.example.com/musicbrainz_db

# Writable `shirabe` coordination DB (source registry, xref, image_cache).
# Optional: the API boots without it; `shirabe sync <source>` errors if a source needs it.
# SHIRABE_DATABASE_URL=postgres://shirabe@db.example.com/shirabe

# Writable `imdb` bulk-mirror DB (IMDb TSV tables). Only the IMDb source needs it.
# IMDB_DATABASE_URL=postgres://shirabe@db.example.com/imdb

# Writable `tmdb` cache/index DB (`tmdb_cache` + `tmdb_id_index`). Only the TMDB source/facade needs it.
# TMDB_DATABASE_URL=postgres://shirabe@db.example.com/tmdb

# Writable `tvdb` cache DB (`tvdb_cache`). Only the TVDB source/facade needs it.
# TVDB_DATABASE_URL=postgres://shirabe@db.example.com/tvdb

# Writable `fanart` cache DB (`fanart_cache`). Only the fanart.tv facade needs it.
# FANART_DATABASE_URL=postgres://shirabe@db.example.com/fanart

# ── HTTP server ─────────────────────────────────────────────

# HTTP bind address:port.
# SHIRABE_BIND=0.0.0.0:8800

# Max Postgres connections per pool. Raise alongside replica count / DB capacity.
# SHIRABE_DB_POOL_SIZE=8

# Default `limit` applied to search endpoints when the client omits one.
# SHIRABE_DEFAULT_LIMIT=25

# Hard cap on the `limit` a client may request.
# SHIRABE_MAX_LIMIT=100

# ── Trigram search tuning ───────────────────────────────────

# pg_trgm similarity threshold (0.0-1.0). Rows below this are discarded.
# SHIRABE_SIMILARITY_THRESHOLD=0.3

# Per-connection `statement_timeout` (ms) on trigram search sessions; runaway queries fail fast.
# SHIRABE_STATEMENT_TIMEOUT_MS=10000

# Per-connection `work_mem` on trigram search sessions. Any Postgres memory unit (`256MB`, `1GB`).
# The Postgres default 4MB makes the GIN bitmap scan over `imdb_title_akas` go lossy.
# SHIRABE_SEARCH_WORK_MEM=256MB

# ── Upstream provider keys ──────────────────────────────────
# All optional: when a key is unset the matching facade degrades to cache-only / 503
# and the server still boots. Keys are held server-side and never re-exposed.

# TMDB v3 API key (`/3` facade + `tmdb` source). Inbound client `api_key` is always ignored.
# TMDB_API_KEY=

# TTL (days) for cached TMDB payloads in `tmdb_cache`.
# TMDB_CACHE_TTL_DAYS=7

# TheTVDB v4 project API key (`/v4` facade + `tvdb` source). Client apikey/pin sent to
# `/v4/login` are accepted and ignored; shirabe mints its own token.
# TVDB_API_KEY=

# Optional operator PIN paired with TVDB_API_KEY (user-supported keys).
# TVDB_PIN=

# TTL (days) for cached TheTVDB payloads in `tvdb_cache`.
# TVDB_CACHE_TTL_DAYS=7

# fanart.tv v3 project API key (`/v3` facade).
# FANART_API_KEY=

# Optional personal fanart.tv key, sent as `client_key` alongside the project key.
# FANART_PERSONAL_API_KEY=

# TTL (days) for cached fanart.tv payloads in `fanart_cache`.
# FANART_CACHE_TTL_DAYS=7

# ── Artwork / Cover Art proxy ───────────────────────────────

# Externally-reachable base URL of the `caache` image proxy. TMDB/TVDB artwork URLs in
# facade payloads are rewritten through its `/_ia/<host>/<path>` passthrough. Empty
# (default) rewrites to shirabe's OWN relative `/_ia/<host>/<path>` route instead.
# SHIRABE_CAACHE_BASE_URL=

# Directory backing the native Cover Art byte cache (`/_ia`). Put it on a PVC.
# SHIRABE_COVERART_CACHE_DIR=/var/cache/shirabe/coverart

# Soft upper bound (bytes) on the byte cache; oldest entries (by mtime) are evicted. ~9 GiB.
# SHIRABE_COVERART_CACHE_MAX_BYTES=9663676416

# Positive-cache TTL (seconds) for 200 image responses. 30 days.
# SHIRABE_COVERART_POSITIVE_TTL_SECS=2592000

# Negative-cache TTL (seconds) for 404 responses. 6 hours.
# SHIRABE_COVERART_NEGATIVE_TTL_SECS=21600

# Upstream Cover Art Archive base for the `/release` and `/release-group` redirect layer.
# SHIRABE_COVERART_UPSTREAM_BASE=https://coverartarchive.org

# ── Debug ───────────────────────────────────────────────────

# Opt-in SQL query explorer at /debug/queries. Lists every SQL statement shirabe runs and
# lets you execute each (and EXPLAIN [ANALYZE]) against the live DBs with adjustable params
# and session knobs. Can run arbitrary EXPLAIN ANALYZE load: keep OFF in exposed deployments.
# Has no effect unless SHIRABE_DEBUG_UI_TOKEN is also set.
# SHIRABE_DEBUG_UI=false

# Bearer token guarding /debug/*: every request needs `Authorization: Bearer <token>` or gets
# 401. When unset or empty the explorer is not mounted at all and a WARN is logged at boot.
# SHIRABE_DEBUG_UI_TOKEN=

# tracing `EnvFilter`. `info` already includes one access-log line per request.
# e.g. `info,shirabe=debug,tower_http=debug`.
# RUST_LOG=info

# ── Testing-only (hidden from --help; never set in a real deployment) ──

# Point a facade at a mock upstream.
# TMDB_API_BASE=https://api.themoviedb.org/3
# TVDB_API_BASE=https://api4.thetvdb.com/v4
# FANART_API_BASE=https://webservice.fanart.tv/v3

# Disable the `/_ia` SSRF guard (allow private/loopback hosts, plain http) so a local mock is reachable.
# SHIRABE_COVERART_INSECURE_IA=false
